---

---

<section class="animate-on-scroll px-6 py-24 md:px-12 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <p class="text-sm font-light uppercase tracking-widest text-offset">Ecosystem</p>
    <h2 class="gradient-text mt-2 text-3xl font-bold md:text-4xl lg:text-5xl">Our Trusted Partners</h2>
    <p class="mt-4 max-w-2xl text-lg font-light text-offset">
      Technology and industry partnerships that power better solutions.
    </p>

    <!-- Technology Partners -->
    <div class="mt-12">
      <h3 class="mb-4 text-sm font-light uppercase tracking-widest text-offset">Technology Partners</h3>
      <div class="flex flex-wrap gap-4">
        {[
          { name: "Thai Programmer Association", logo: "https://cdn.simpleicons.org/thaiprogrammerassociation/FFFFFF" },
          { name: "DEPA", logo: "https://cdn.simpleicons.org/depahashtag/0066CC" },
          { name: "DCT", logo: "https://cdn.simpleicons.org/digitalcouncilofthailand/FFFFFF" },
          { name: "DTE", logo: "https://cdn.simpleicons.org/digitaltechentrepreneur/FFFFFF" },
        ].map(({ name, logo }) => (
          <div class="glass-card flex items-center gap-3 px-4 py-3 opacity-70 transition-all duration-300 hover:opacity-100">
            <img
              src={logo}
              alt={name}
              width={24}
              height={24}
              loading="lazy"
              class="size-6 object-contain"
              onerror={`this.style.display='none'`}
            />
            <span class="text-sm font-light text-offset">{name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Product & Integration Partners -->
    <div class="mt-8">
      <h3 class="mb-4 text-sm font-light uppercase tracking-widest text-offset">Product & Integration Partners</h3>
      <div class="flex flex-wrap gap-4">
        {[
          { name: "LINE", logo: "https://cdn.simpleicons.org/line/00C300" },
          { name: "ChillPay", logo: "https://cdn.simpleicons.org/chillpay/FFFFFF" },
          { name: "Supabase", logo: "https://cdn.simpleicons.org/supabase/3FCF8E" },
          { name: "Cloudflare", logo: "https://cdn.simpleicons.org/cloudflare/F38020" },
          { name: "AWS", logo: "https://cdn.simpleicons.org/amazonaws/FF9900" },
          { name: "Google Cloud", logo: "https://cdn.simpleicons.org/googlecloud/4285F4" },
        ].map(({ name, logo }) => (
          <div class="glass-card flex items-center gap-3 px-4 py-3 opacity-70 transition-all duration-300 hover:opacity-100">
            <img
              src={logo}
              alt={name}
              width={24}
              height={24}
              loading="lazy"
              class="size-6 object-contain"
              onerror={`this.style.display='none'`}
            />
            <span class="text-sm font-light text-offset">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
