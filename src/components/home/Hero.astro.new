---
const words = ["Systems.", "Platforms.", "Experiences.", "Products.", "Solutions."];
const trustBadges = [
  { label: "50+ Projects Delivered" },
  { label: "DEPA Committee Member" },
  { label: "Open Source Contributors" },
];
---

<section id="about" class="relative flex min-h-screen items-center justify-center overflow-hidden">
  {/* Background gradient orbs */}
  <div class="absolute -left-32 top-1/4 size-[600px] rounded-full bg-[rgba(240,77,45,0.12)] blur-[150px]" aria-hidden="true"></div>
  <div class="absolute -right-32 bottom-1/4 size-[500px] rounded-full bg-[rgba(237,27,93,0.08)] blur-[130px]" aria-hidden="true"></div>
  <div class="absolute left-1/2 top-1/2 size-[300px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[rgba(239,54,67,0.06)] blur-[100px]" aria-hidden="true"></div>

  {/* Subtle grid pattern overlay */}
  <div class="hero-grid-bg absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6 py-32">
    <div class="flex flex-col items-center text-center">
      {/* Eyebrow pill */}
      <div class="mb-8 flex items-center gap-2 rounded-full bg-[rgba(255,255,255,0.05)] px-5 py-2 backdrop-blur-md">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
        </span>
        <span class="text-xs font-light text-offset">Available for new projects</span>
      </div>

      {/* Main heading */}
      <h1 class="text-5xl font-bold leading-[1.1] text-default md:text-7xl lg:text-8xl">
        We Build<br />
        <span class="gradient-text">What Matters.</span>
      </h1>

      {/* Cycling words */}
      <div class="mt-4 h-[1.2em] overflow-hidden">
        <ul class="hero-word-list block text-3xl font-bold leading-tight text-default md:text-5xl lg:text-6xl animate-text-slide">
          {words.map((word) => (
            <li class="gradient-text">{word}</li>
          ))}
          <li aria-hidden="true" class="gradient-text">{words[0]}</li>
        </ul>
      </div>

      {/* Subtitle */}
      <p class="mt-8 max-w-xl text-lg font-light leading-relaxed text-offset md:text-xl">
        Code Passion builds production-ready systems for Thai businesses and beyond — with precision, speed, and passion.
      </p>

      {/* CTA Buttons */}
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="#contact"
          class="group inline-flex items-center gap-2 rounded-2xl brand-gradient px-7 py-3.5 text-sm font-medium text-white hero-glow-btn transition-all duration-300 hover:scale-105"
        >
          Start Your Project
          <svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#services"
          class="inline-flex items-center gap-2 rounded-2xl bg-[rgba(255,255,255,0.05)] px-7 py-3.5 text-sm font-medium text-default backdrop-blur-md transition-all duration-300 hover:bg-[rgba(255,255,255,0.1)] hover:text-brand-red"
        >
          Explore Services
        </a>
      </div>

      {/* Terminal mockup — frosted glass */}
      <div class="mt-20 w-full max-w-2xl">
        <div class="overflow-hidden rounded-2xl bg-[rgba(255,255,255,0.03)] hero-terminal-shadow backdrop-blur-xl">
          {/* Terminal header */}
          <div class="flex items-center gap-2 px-5 py-3.5">
            <span class="size-3 rounded-full bg-[#EF4444]"></span>
            <span class="size-3 rounded-full bg-[#F59E0B]"></span>
            <span class="size-3 rounded-full bg-[#22C55E]"></span>
            <span class="ml-2 text-xs font-light text-offset font-mono">app.ts</span>
            <div class="ml-auto flex items-center gap-1">
              <span class="size-1.5 rounded-full bg-green-500"></span>
              <span class="text-[10px] text-green-400">ready</span>
            </div>
          </div>

          {/* Terminal body */}
          <div class="border-t border-[rgba(255,255,255,0.05)] p-6 font-mono text-sm leading-loose">
            <div class="text-offset">
              <span class="text-brand-red">import</span> <span class="text-[#E5C07B]">{ Workengine }</span> <span class="text-brand-red">from</span> <span class="text-green-400">'@codepassion/core'</span>
            </div>
            <div class="mt-3 text-offset">
              <span class="text-brand-red">const</span> <span class="text-[#61AFEF]">app</span> = <span class="text-brand-red">new</span> <span class="text-[#E5C07B]">Workengine</span>({
            </div>
            <div class="pl-4 text-offset">
              <span class="text-[#E06C75]">stack</span>: <span class="text-green-400">'nextjs-16'</span>,
            </div>
            <div class="pl-4 text-offset">
              <span class="text-[#E06C75]">database</span>: <span class="text-green-400">'supabase'</span>,
            </div>
            <div class="pl-4 text-offset">
              <span class="text-[#E06C75]">runtime</span>: <span class="text-green-400">'bun'</span>,
            </div>
            <div class="text-offset">})</div>
            <div class="mt-3 text-offset">
              <span class="text-brand-red">await</span> app.<span class="text-[#61AFEF]">deploy</span>()<span class="cursor-blink gradient-text">|</span>
            </div>
          </div>
        </div>
      </div>

      {/* Trust badges — glass pills */}
      <div class="mt-14 flex flex-wrap justify-center gap-4">
        {trustBadges.map(({ label }) => (
          <div class="flex items-center gap-2.5 rounded-full bg-[rgba(255,255,255,0.04)] px-5 py-2 backdrop-blur-md">
            <span class="size-1.5 rounded-full brand-gradient"></span>
            <span class="text-xs font-light text-offset">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* Bottom gradient fade */}
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent" aria-hidden="true"></div>
</section>
