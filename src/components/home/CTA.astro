---
import { Icon } from "astro-icon/components";
---

<section
  id="contact"
  class="relative overflow-hidden px-6 py-24 md:px-12 lg:py-32"
>
  <div class="brand-gradient absolute inset-0 opacity-90"></div>
  <div class="noise-overlay absolute inset-0"></div>

  <div class="relative z-10 mx-auto max-w-4xl text-center">
    <h2 class="font-bold text-white text-3xl md:text-4xl lg:text-5xl">
      Ready to Build Something Great?
    </h2>
    <p class="mt-4 font-light text-[rgba(255,255,255,0.8)] text-lg">
      Let's talk about your project. Free consultation, no pressure.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="tel:+66886384566"
        id="cta-book-call"
        class="rounded-md bg-white px-6 py-3 font-medium text-[#252525] transition-colors text-sm hover:bg-[rgba(255,255,255,0.9)]"
      >
        Book a Free Call
      </a>
      <a
        href="https://facebook.com/codepassion.co"
        target="_blank"
        rel="noopener noreferrer"
        id="cta-facebook-message"
        class="rounded-md border border-[rgba(255,255,255,0.3)] px-6 py-3 font-medium text-white transition-colors text-sm hover:bg-[rgba(255,255,255,0.1)]"
      >
        Message Us on Facebook
      </a>
    </div>

    <div
      class="mt-10 flex flex-wrap justify-center gap-6 text-[rgba(255,255,255,0.7)] text-sm"
    >
      <a
        href="tel:+66886384566"
        class="flex items-center gap-2 transition-colors hover:text-white"
      >
        <Icon name="mdi:call" class="size-4" />
        +66 88 638 4566
      </a>
      <a
        href="https://facebook.com/codepassion.co"
        class="flex items-center gap-2 transition-colors hover:text-white"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="fa-brands:facebook" class="size-4" />
        Facebook
      </a>
      <a
        href="https://github.com/codepassion-team"
        class="flex items-center gap-2 transition-colors hover:text-white"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="fa-brands:github" class="size-4" />
        GitHub
      </a>
      <a
        href="https://www.youtube.com/@code-passion"
        class="flex items-center gap-2 transition-colors hover:text-white"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="fa-brands:youtube" class="size-4" />
        YouTube
      </a>
    </div>
  </div>

  <script is:inline>
    document
      .getElementById("cta-book-call")
      ?.addEventListener("click", function () {
        if (typeof fbq !== "undefined") fbq("track", "Lead");
      });
    document
      .getElementById("cta-facebook-message")
      ?.addEventListener("click", function () {
        if (typeof fbq !== "undefined") fbq("track", "Contact");
      });
  </script>
</section>
