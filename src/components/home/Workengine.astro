---
---

<section id="workengine" class="animate-on-scroll bg-offset px-6 py-24 md:px-12 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <p class="text-sm font-light uppercase tracking-widest text-offset">Core Product</p>
    <h2 class="gradient-text mt-2 text-3xl font-bold md:text-4xl lg:text-5xl">Introducing Workengine 0.1</h2>
    <p class="mt-4 max-w-2xl text-lg font-light text-offset">
      The innovation behind modern business.
    </p>

    <!-- Comparison card -->
    <div class="mt-12 glass-card overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="border-b border-border-default p-8 md:border-b-0 md:border-r">
          <h3 class="mb-4 text-sm font-light uppercase tracking-widest text-offset">Traditional Development</h3>
          <ul class="space-y-3 text-sm font-light text-offset">
            <li class="flex items-start gap-2"><span class="mt-1 text-red-500">&#x2717;</span> Time-consuming setup and configuration</li>
            <li class="flex items-start gap-2"><span class="mt-1 text-red-500">&#x2717;</span> Fragmented systems and tooling</li>
            <li class="flex items-start gap-2"><span class="mt-1 text-red-500">&#x2717;</span> Difficult to debug and maintain</li>
          </ul>
        </div>
        <div class="p-8">
          <h3 class="mb-4 text-sm font-light uppercase tracking-widest gradient-text">Workengine 0.1</h3>
          <ul class="space-y-3 text-sm font-light text-default">
            <li class="flex items-start gap-2"><span class="mt-1 text-green-500">&#x2713;</span> Ready-to-use architecture from day one</li>
            <li class="flex items-start gap-2"><span class="mt-1 text-green-500">&#x2713;</span> Seamlessly integrated tooling</li>
            <li class="flex items-start gap-2"><span class="mt-1 text-green-500">&#x2713;</span> Proven in real production businesses</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 3 Value Props -->
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="glass-card p-6">
        <div class="mb-3 flex size-10 items-center justify-center rounded-lg brand-gradient">
          <span class="text-lg text-white">&#x2699;</span>
        </div>
        <h3 class="text-lg font-medium text-default">Production-Ready Architecture</h3>
        <p class="mt-2 text-sm font-light leading-relaxed text-offset">Deploy enterprise-grade systems from day one. No setup hell, no fragmented tooling.</p>
      </div>
      <div class="glass-card p-6">
        <div class="mb-3 flex size-10 items-center justify-center rounded-lg brand-gradient">
          <span class="text-lg text-white">&#x26A1;</span>
        </div>
        <h3 class="text-lg font-medium text-default">Built for Scale, Speed & Clarity</h3>
        <p class="mt-2 text-sm font-light leading-relaxed text-offset">Designed to grow with your business without rewriting your stack.</p>
      </div>
      <div class="glass-card p-6">
        <div class="mb-3 flex size-10 items-center justify-center rounded-lg brand-gradient">
          <span class="text-lg text-white">&#x2197;</span>
        </div>
        <h3 class="text-lg font-medium text-default">Instantly Scalable</h3>
        <p class="mt-2 text-sm font-light leading-relaxed text-offset">Infrastructure that reduces development time while maintaining enterprise standards.</p>
      </div>
    </div>

    <!-- Integration ecosystem -->
    <div class="mt-12 glass-card p-8">
      <h3 class="mb-6 text-center text-lg font-medium text-default">Seamlessly connecting all critical services.</h3>
      <div class="flex flex-wrap items-center justify-center gap-6">
        <div class="flex flex-col items-center gap-2 rounded-lg border border-border-default bg-background-card p-4">
          <span class="text-2xl">&#x1F4B3;</span>
          <span class="text-xs font-light text-offset">ChillPay</span>
          <span class="text-[10px] text-muted-foreground">Payment & PayLink</span>
        </div>
        <div class="hidden text-muted-foreground md:block">&#x2194;</div>
        <div class="flex flex-col items-center gap-2 rounded-lg border-2 border-[rgba(240,77,45,0.3)] bg-background-card p-4">
          <span class="text-2xl font-bold gradient-text">WE</span>
          <span class="text-xs font-medium text-default">Workengine 0.1</span>
          <span class="text-[10px] text-muted-foreground">Core Platform</span>
        </div>
        <div class="hidden text-muted-foreground md:block">&#x2194;</div>
        <div class="flex flex-col items-center gap-2 rounded-lg border border-border-default bg-background-card p-4">
          <span class="text-2xl">&#x1F4AC;</span>
          <span class="text-xs font-light text-offset">LINE</span>
          <span class="text-[10px] text-muted-foreground">Login & Messaging</span>
        </div>
        <div class="hidden text-muted-foreground md:block">&#x2194;</div>
        <div class="flex flex-col items-center gap-2 rounded-lg border border-border-default bg-background-card p-4">
          <span class="text-2xl">&#x26A1;</span>
          <span class="text-xs font-light text-offset">Supabase</span>
          <span class="text-[10px] text-muted-foreground">Database & Functions</span>
        </div>
        <div class="hidden text-muted-foreground md:block">&#x2194;</div>
        <div class="flex flex-col items-center gap-2 rounded-lg border border-border-default bg-background-card p-4">
          <span class="text-2xl">&#x1F9E0;</span>
          <span class="text-xs font-light text-offset">Thunder API</span>
          <span class="text-[10px] text-muted-foreground">AI OCR & Verification</span>
        </div>
      </div>
    </div>

    <!-- Tech stack pills -->
    <div class="mt-8 text-center">
      <p class="mb-3 text-xs font-light uppercase tracking-widest text-offset">Powered by</p>
      <div class="flex flex-wrap justify-center gap-2">
        {["Next.js 16", "React 19", "Bun + ElysiaJS", "PostgreSQL", "Drizzle ORM", "Supabase", "Turborepo"].map((tech) => (
          <span class="rounded-full border border-border-default px-3 py-1 text-xs font-light text-offset">
            {tech}
          </span>
        ))}
      </div>
      <p class="mt-4 text-xs font-light text-offset">
        Ultra-low latency. Type-safe from end to end. Frictionless developer experience.
      </p>
    </div>

    <!-- Engineering standards -->
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      {[
        "Abstract Static Classes",
        "Conventional Commits",
        "Prettier Enforced",
        "Drizzle Schema Migrations",
        "Self-managing Webhooks",
        "CI/CD in 14 seconds",
      ].map((badge) => (
        <span class="flex items-center gap-1 rounded-full border border-[rgba(34,197,94,0.2)] bg-[rgba(34,197,94,0.05)] px-3 py-1 text-xs font-light text-green-400">
          <span>&#x2713;</span> {badge}
        </span>
      ))}
    </div>

    <div class="mt-8 text-center">
      <a
        href="#"
        class="inline-flex items-center gap-2 rounded-md border border-border-default px-6 py-3 text-sm font-medium text-default hover:border-brand-red hover:text-brand-red transition-colors"
      >
        Learn More About Workengine &rarr;
      </a>
    </div>
  </div>
</section>
