---

---

<section
  id="workengine"
  class="animate-on-scroll bg-offset px-6 py-24 md:px-12 lg:py-32"
>
  <div class="mx-auto max-w-7xl">
    <p class="font-light uppercase tracking-widest text-offset text-sm">
      Core Product
    </p>
    <h2 class="gradient-text mt-2 font-bold text-3xl md:text-4xl lg:text-5xl">
      Introducing Workengine 0.1
    </h2>
    <p class="mt-4 max-w-2xl font-light text-offset text-lg">
      The innovation behind modern business.
    </p>

    <!-- Comparison card -->
    <div class="glass-card mt-12 overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div
          class="border-border-default border-b p-8 md:border-b-0 md:border-r"
        >
          <h3
            class="mb-4 font-light uppercase tracking-widest text-offset text-sm"
          >
            Traditional Development
          </h3>
          <ul class="space-y-3 font-light text-offset text-sm">
            <li class="flex items-start gap-2">
              <span class="mt-1 text-red-500">&#x2717;</span> Time-consuming setup
              and configuration
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 text-red-500">&#x2717;</span> Fragmented systems and
              tooling
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 text-red-500">&#x2717;</span> Difficult to debug and
              maintain
            </li>
          </ul>
        </div>
        <div class="p-8">
          <h3
            class="gradient-text mb-4 font-light uppercase tracking-widest text-sm"
          >
            Workengine 0.1
          </h3>
          <ul class="space-y-3 font-light text-default text-sm">
            <li class="flex items-start gap-2">
              <span class="mt-1 text-green-500">&#x2713;</span> Ready-to-use architecture
              from day one
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 text-green-500">&#x2713;</span> Seamlessly integrated
              tooling
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 text-green-500">&#x2713;</span> Proven in real production
              businesses
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 3 Value Props -->
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="glass-card p-6">
        <div
          class="brand-gradient mb-3 flex size-10 items-center justify-center rounded-lg"
        >
          <span class="text-white text-lg">&#x2699;</span>
        </div>
        <h3 class="font-medium text-default text-lg">
          Production-Ready Architecture
        </h3>
        <p class="mt-2 font-light leading-relaxed text-offset text-sm">
          Deploy enterprise-grade systems from day one. No setup hell, no
          fragmented tooling.
        </p>
      </div>
      <div class="glass-card p-6">
        <div
          class="brand-gradient mb-3 flex size-10 items-center justify-center rounded-lg"
        >
          <span class="text-white text-lg">&#x26A1;</span>
        </div>
        <h3 class="font-medium text-default text-lg">
          Built for Scale, Speed & Clarity
        </h3>
        <p class="mt-2 font-light leading-relaxed text-offset text-sm">
          Designed to grow with your business without rewriting your stack.
        </p>
      </div>
      <div class="glass-card p-6">
        <div
          class="brand-gradient mb-3 flex size-10 items-center justify-center rounded-lg"
        >
          <span class="text-white text-lg">&#x2197;</span>
        </div>
        <h3 class="font-medium text-default text-lg">Instantly Scalable</h3>
        <p class="mt-2 font-light leading-relaxed text-offset text-sm">
          Infrastructure that reduces development time while maintaining
          enterprise standards.
        </p>
      </div>
    </div>

    <!-- Integration ecosystem -->
    <div class="glass-card mt-12 p-8">
      <h3 class="mb-6 text-center font-medium text-default text-lg">
        Seamlessly connecting all critical services.
      </h3>
      <div class="flex flex-wrap items-center justify-center gap-6">
        <div
          class="border-border-default bg-background-card flex flex-col items-center gap-2 rounded-lg border p-4"
        >
          <span class="text-2xl">&#x1F4B3;</span>
          <span class="font-light text-offset text-xs">ChillPay</span>
          <span class="text-muted-foreground text-[10px]"
            >Payment & PayLink</span
          >
        </div>
        <div class="text-muted-foreground hidden md:block">&#x2194;</div>
        <div
          class="bg-background-card flex flex-col items-center gap-2 rounded-lg border-2 border-[rgba(240,77,45,0.3)] p-4"
        >
          <span class="gradient-text font-bold text-2xl">WE</span>
          <span class="font-medium text-default text-xs">Workengine 0.1</span>
          <span class="text-muted-foreground text-[10px]">Core Platform</span>
        </div>
        <div class="text-muted-foreground hidden md:block">&#x2194;</div>
        <div
          class="border-border-default bg-background-card flex flex-col items-center gap-2 rounded-lg border p-4"
        >
          <span class="text-2xl">&#x1F4AC;</span>
          <span class="font-light text-offset text-xs">LINE</span>
          <span class="text-muted-foreground text-[10px]"
            >Login & Messaging</span
          >
        </div>
        <div class="text-muted-foreground hidden md:block">&#x2194;</div>
        <div
          class="border-border-default bg-background-card flex flex-col items-center gap-2 rounded-lg border p-4"
        >
          <span class="text-2xl">&#x26A1;</span>
          <span class="font-light text-offset text-xs">Supabase</span>
          <span class="text-muted-foreground text-[10px]"
            >Database & Functions</span
          >
        </div>
        <div class="text-muted-foreground hidden md:block">&#x2194;</div>
        <div
          class="border-border-default bg-background-card flex flex-col items-center gap-2 rounded-lg border p-4"
        >
          <span class="text-2xl">&#x1F9E0;</span>
          <span class="font-light text-offset text-xs">Thunder API</span>
          <span class="text-muted-foreground text-[10px]"
            >AI OCR & Verification</span
          >
        </div>
      </div>
    </div>

    <!-- Tech stack pills -->
    <div class="mt-8 text-center">
      <p class="mb-3 font-light uppercase tracking-widest text-offset text-xs">
        Powered by
      </p>
      <div class="flex flex-wrap justify-center gap-2">
        {
          [
            "Next.js 16",
            "React 19",
            "Bun + ElysiaJS",
            "PostgreSQL",
            "Drizzle ORM",
            "Supabase",
            "Turborepo",
          ].map((tech) => (
            <span class="border-border-default rounded-full border px-3 py-1 font-light text-offset text-xs">
              {tech}
            </span>
          ))
        }
      </div>
      <p class="mt-4 font-light text-offset text-xs">
        Ultra-low latency. Type-safe from end to end. Frictionless developer
        experience.
      </p>
    </div>

    <!-- Engineering standards -->
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      {
        [
          "Abstract Static Classes",
          "Conventional Commits",
          "Prettier Enforced",
          "Drizzle Schema Migrations",
          "Self-managing Webhooks",
          "CI/CD in 14 seconds",
        ].map((badge) => (
          <span class="flex items-center gap-1 rounded-full border border-[rgba(34,197,94,0.2)] bg-[rgba(34,197,94,0.05)] px-3 py-1 font-light text-green-400 text-xs">
            <span>&#x2713;</span> {badge}
          </span>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a
        href="#"
        class="border-border-default inline-flex items-center gap-2 rounded-md border px-6 py-3 font-medium text-default transition-colors text-sm hover:border-brand-red hover:text-brand-red"
      >
        Learn More About Workengine &rarr;
      </a>
    </div>
  </div>
</section>
