---
import Navbar from "~/components/layout/Navbar.astro";
---

<Navbar />

<!-- Hero Section -->
<section class="mb-32 px-4 py-32 text-center">
  <h1 class="font-medium tracking-tight text-5xl md:text-2xl">Careers</h1>
  <p class="mx-auto mb-14 max-w-2xl font-light text-lg md:text-xl">
    Help us build the future of technology. We're looking for passionate people
    to make a difference.
  </p>
  <a
    href="#positions"
    class="inline-block rounded-xl px-12 py-5 font-normal shadow transition text-lg hover:bg-gray-100"
    >See Open Positions</a
  >
</section>

<!-- About Section -->
<section class="mx-auto mb-32 max-w-4xl px-4 text-center">
  <h2 class="mb-6 font-bold tracking-tight text-2xl md:text-5xl">
    Why Work With Us?
  </h2>
  <p class="font-light text-lg md:text-xl">
    At CodePassion, we're dedicated to solving challenging problems and making a
    positive impact. Our team values curiosity, creativity, and collaboration.
    Join us to work on projects that matter, with people who care.
  </p>
</section>

<!-- Benefits Section -->
<section class="container mx-auto mb-32 px-4">
  <h2 class="mb-16 text-center font-bold tracking-tight text-2xl md:text-5xl">
    Benefits
  </h2>
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3">
      <div class="rounded-lg border border-gray-200 bg-gray-50 p-6 text-left">
        <h3 class="mb-6 font-medium text-lg">Flexible Work</h3>
        <p class="font-light text-gray-700 text-lg">
          Remote-friendly culture and flexible hours to fit your lifestyle.
        </p>
      </div>
      <div class="rounded-lg border border-gray-200 bg-gray-50 p-6 text-left">
        <h3 class="mb-6 font-medium text-lg">Health & Wellness</h3>
        <p class="font-light text-gray-700 text-lg">
          Comprehensive health, dental, and vision coverage for you and your
          family.
        </p>
      </div>
      <div class="rounded-lg border border-gray-200 bg-gray-50 p-6 text-left">
        <h3 class="mb-6 font-medium text-lg">Growth & Learning</h3>
        <p class="font-light text-gray-700 text-lg">
          Annual learning stipend and opportunities for professional
          development.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Open Positions Section -->
<section id="positions" class="mx-auto mb-32 max-w-5xl px-4 py-20">
  <h2 class="mb-16 text-center font-light tracking-tight text-3xl md:text-4xl">
    Open Positions
  </h2>
  <div class="space-y-12">
    <div
      class="flex flex-col rounded-2xl border border-gray-200 bg-white p-10 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <h3 class="mb-2 font-normal text-2xl">Frontend Engineer</h3>
        <p class="font-light text-gray-500 text-lg">Remote · Full-time</p>
      </div>
      <a
        href="#"
        class="mp:mt-0 inline-block rounded-xl bg-black px-10 py-4 pt-8 font-normal text-white transition text-lg hover:bg-gray-900"
        >Apply</a
      >
    </div>
    <div
      class="flex flex-col rounded-2xl border border-gray-200 bg-white p-10 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <h3 class="mb-2 font-normal text-2xl">Backend Developer</h3>
        <p class="font-light text-gray-500 text-lg">Remote · Full-time</p>
      </div>
      <a
        href="#"
        class="mp:mt-0 inline-block rounded-xl bg-black px-10 py-4 pt-8 font-normal text-white transition text-lg hover:bg-gray-900"
        >Apply</a
      >
    </div>
    <div
      class="flex flex-col rounded-2xl border border-gray-200 bg-white p-10 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <h3 class="mb-2 font-normal text-2xl">Product Designer</h3>
        <p class="font-light text-gray-500 text-lg">Remote · Full-time</p>
      </div>
      <a
        href="#"
        class="mp:mt-0 inline-block rounded-xl bg-black px-10 py-4 pt-8 font-normal text-white transition text-lg hover:bg-gray-900"
        >Apply</a
      >
    </div>
  </div>
</section>

<!-- Diversity & Inclusion Section -->
<section class="mb-32 border-b border-t border-gray-200 bg-white px-4 py-20">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="mb-6 font-light tracking-tight text-3xl md:text-4xl">
      Diversity & Inclusion
    </h2>
    <p class="font-light text-xl md:text-2xl">
      We're committed to building a diverse and inclusive team. We welcome
      applicants from all backgrounds and experiences. Your unique perspective
      helps us grow and innovate.
    </p>
  </div>
</section>

<!-- Contact / Footer Section -->
<section class="bg-black px-4 py-20 text-center text-white">
  <h2 class="mb-6 font-light text-2xl md:text-3xl">Ready to make an impact?</h2>
  <p class="mb-8 font-light text-lg">
    Send your resume or questions to <a
      href="mailto:careers@codepassion.dev"
      class="underline hover:text-gray-300">careers@codepassion.dev</a>
  </p>
  <p class="font-light text-gray-400 text-base">
    © {new Date().getFullYear()} CodePassion. All rights reserved.
  </p>
</section>
