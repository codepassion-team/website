---
import "~/styles/index.css";
import "@fontsource-variable/noto-sans-thai";
import "@fontsource/mitr";
import "@fontsource/jetbrains-mono";
import "@fontsource/prompt/700.css";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Analytics from "~/components/landing/Analytics.astro";
import codePassionLogo from "~/assets/logos/CodePassion_Icon.svg";
import supportAgentPhoto from "~/assets/line-oa/support-agent.jpg";
import calibrationLabPhoto from "~/assets/line-oa/calibration-lab.jpg";
import repairTechnicianPhoto from "~/assets/line-oa/repair-technician.jpg";
import customerPhonePhoto from "~/assets/line-oa/customer-phone.jpg";
import { channels as socialChannels, company } from "~/data/landing";

const PRODUCT_NAME = "Customer Portal บน LINE OA";
const SOCIAL_ICONS: Record<string, string> = {
  YouTube: "fa-brands:youtube",
  "LINE OA": "fa-brands:line",
  Facebook: "fa-brands:facebook",
  TikTok: "fa-brands:tiktok",
};
const PAGE_URL = "https://codepassion.co/line-oa/";
const TITLE = `${PRODUCT_NAME} ให้ลูกค้าเช็กงานเอง | CodePassion`;
const DESCRIPTION =
  "ให้ลูกค้าติดตามสถานะงาน ขอเอกสาร และรับแจ้งเตือนเองผ่าน LINE OA ออกแบบให้เข้ากับงานบริการและระบบเดิมของคุณ นัดดู Demo 20 นาที ไม่มีค่าใช้จ่าย";
const OG_IMAGE = "https://codepassion.co/og/line-oa.png";
const LINE_URL = "https://line.me/ti/p/@codepassion";
const LINE_HANDLE = "@codepassion";
const LINE_CTA = `เพิ่มเพื่อน LINE ${LINE_HANDLE}`;
const LINE_CTA_NOTE = "ทักแชทเพื่อนัดดู Demo 20 นาที ไม่มีค่าใช้จ่าย";
const PRIVACY_POLICY_URL = import.meta.env.PUBLIC_PRIVACY_POLICY_URL ?? "";

const navLinks = [
  { href: "#use-cases", label: "ตัวอย่างใช้งาน" },
