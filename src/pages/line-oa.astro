        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-text);
      }
      .loa-status {
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
        font-size: 0.7rem;
        white-space: nowrap;
      }
      .loa-status-progress {
        background: rgba(6, 199, 85, 0.12);
        color: var(--loa-accent);
      }
      .loa-status-done {
