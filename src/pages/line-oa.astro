const fitCheckItems = [
  "ระบบเดิมติดข้อจำกัดตรงไหน",
  "ขั้นตอนใดที่ยังต้องทำด้วยมือ",
  "ลูกค้าหลุดตรงจุดใด",
  "ฟังก์ชันใดควรเก็บไว้",
  "ส่วนใดควรปรับหรือพัฒนาเพิ่ม",
  "Custom Solution แบบใดเหมาะกับธุรกิจคุณ",
