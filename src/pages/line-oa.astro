const ctaClass =
  "loa-btn-line inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-4 py-3.5 text-sm font-bold transition-all duration-300 hover:-translate-y-0.5 sm:px-7 sm:text-[15px]";
const lineLink = {
  href: LINE_URL,
  target: "_blank",
  rel: "noopener noreferrer",
};
---

<!doctype html>
<html lang="th" class="h-full motion-safe:scroll-smooth" data-theme="light">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={PAGE_URL} />

    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:url" content={PAGE_URL} />
    <meta property="og:title" content={TITLE} />
    <meta
      property="og:description"
      content="คืนเวลาให้เจ้าหน้าที่ดูแลงานที่ต้องใช้คน นัดดู Demo และคุยปัญหา 20 นาที ไม่มีค่าใช้จ่าย"
    />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={TITLE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={OG_IMAGE} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: PRODUCT_NAME,
        serviceType: "Customer portal development on LINE Official Account",
        description: DESCRIPTION,
        url: PAGE_URL,
        areaServed: { "@type": "Country", name: "Thailand" },
        availableLanguage: "Thai",
        provider: {
          "@type": "Organization",
          "@id": "https://codepassion.co/#organization",
          name: "CodePassion",
          legalName: "Code Passion Co., Ltd.",
          url: "https://codepassion.co",
        },
      })}
    />

    <script is:inline>
      const themeSaved = localStorage.getItem("theme");
      if (themeSaved) {
        document.documentElement.dataset.theme = themeSaved;
      }
    </script>

    <Analytics />
  </head>

  <body
    class="loa-body h-full overflow-x-hidden bg-background text-foreground selection:bg-brand-red selection:text-white"
  >
    <a href="#main" class="skip-to-content">ข้ามไปยังเนื้อหาหลัก</a>

    <header
      id="loa-navbar"
      class="fixed top-0 z-50 w-full border-b border-transparent transition-all duration-300"
    >
      <nav
        class="loa-gutter flex items-center justify-between gap-4 py-3 sm:py-4 xl:grid xl:grid-cols-[1fr_auto_1fr]"
        aria-label="เมนูหลัก"
      >
        <a
          class="loa-logo justify-self-start"
          href="#main"
          aria-label="LINE OA สำหรับธุรกิจบริการ - กลับด้านบน"
        >
          <span class="loa-logo-badge">LINE OA</span>
          <span class="loa-logo-text">สำหรับธุรกิจบริการ</span>
        </a>
        <ul class="loa-nav-links hidden items-center xl:flex">
          {
            navLinks.map((link) => (
              <li>
                <a
                  class="loa-nav-link font-light text-offset transition-colors text-sm hover:text-default"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="flex items-center gap-1 justify-self-end sm:gap-2">
          <button
            id="loa-theme-toggle"
            type="button"
            class="hover:bg-background-offset rounded-lg p-2 text-default transition-colors"
            aria-label="สลับธีมสว่าง/มืด"
          >
            <Icon
              id="loa-icon-light"
              name="mdi:white-balance-sunny"
              class="size-5"
            />
            <Icon
              id="loa-icon-dark"
              name="mdi:weather-night"
              class="hidden size-5"
            />
          </button>
          <a
            {...lineLink}
            data-line-cta="nav"
            class="loa-btn-line hidden h-11 items-center gap-2 whitespace-nowrap rounded-full px-5 font-bold transition-all text-sm md:inline-flex"
            ><Icon
              name="fa-brands:line"
              class="size-5"
              aria-hidden="true"
            />เพิ่มเพื่อน LINE<span class="-ml-1 hidden xl:inline"
              >{` ${LINE_HANDLE}`}</span
            ></a
          >
          <button
            id="loa-menu-toggle"
            type="button"
            class="hover:bg-background-offset rounded-lg p-2 text-default transition-colors xl:hidden"
            aria-label="เปิดเมนู"
            aria-expanded="false"
            aria-controls="loa-mobile-menu"
          >
            <Icon id="loa-menu-open" name="mdi:menu" class="size-6" />
            <Icon id="loa-menu-close" name="mdi:close" class="hidden size-6" />
          </button>
        </div>
      </nav>
      <div id="loa-mobile-menu" class="loa-menu xl:hidden" hidden>
        <ul class="loa-gutter grid pb-6 pt-2">
          {
            navLinks.map((link) => (
              <li>
                <a
                  class="flex items-center justify-between border-b border-border py-4 text-default text-lg"
                  href={link.href}
                >
                  {link.label}
                  <Icon name="mdi:arrow-right" class="size-5 text-offset" />
                </a>
              </li>
            ))
          }
          <li class="pt-6">
            <a
              {...lineLink}
              data-line-cta="menu"
              class:list={[ctaClass, "w-full"]}
              ><Icon name="fa-brands:line" class="size-5" aria-hidden="true" />{
                LINE_CTA
              }</a
            >
          </li>
        </ul>
      </div>
    </header>

    <a
      {...lineLink}
      data-line-cta="mobile"
      class="loa-mobile-cta is-hidden"
      aria-hidden="true"
      tabindex="-1"
      id="loa-mobile-cta"
      ><Icon name="fa-brands:line" class="size-5" aria-hidden="true" />{
        LINE_CTA
      }</a
    >

    <main id="main">
      {/* 1 — HERO */}
      <section
        id="hero"
        class="relative overflow-hidden px-6 pb-20 pt-28 md:px-12 md:pt-36 lg:pb-28"
      >
        <div
          class="absolute -left-32 top-1/4 size-[600px] rounded-full bg-[rgba(6,199,85,0.1)] blur-[150px]"
          aria-hidden="true"
        >
        </div>
        <div class="hero-grid-bg absolute inset-0" aria-hidden="true"></div>

        <div
          class="relative z-10 mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[1.15fr_0.85fr]"
        >
          <div>
            <p class="font-light tracking-wide text-brand-red text-sm">
              Customer Portal บน LINE OA สำหรับธุรกิจบริการ
            </p>
            <h1
              class="mt-4 font-bold text-default text-4xl md:text-5xl lg:text-[3.4rem]"
            >
              ให้ลูกค้าเช็กงานเอง<span class="whitespace-nowrap">ผ่าน LINE</span
              >
              <span class="gradient-text mt-1 block text-[0.74em]"
                ><span class="whitespace-nowrap">คืนเวลาให้เจ้าหน้าที่</span
                ><wbr /><span class="whitespace-nowrap"
                  >ดูแลงานที่ต้องใช้คน</span
                ></span
              >
            </h1>
            <p
              class="mt-6 max-w-2xl font-light leading-relaxed text-offset text-lg"
            >
              เปลี่ยนคำถามซ้ำ ๆ อย่าง “งานถึงไหนแล้ว?” “ขอเอกสารอีกครั้งได้ไหม?”
