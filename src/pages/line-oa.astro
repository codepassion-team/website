      @media (min-width: 768px) {
        .loa-logo {
          gap: 0.6rem;
        }
        .loa-logo-badge {
          display: inline-flex;
          height: 2.75rem;
          align-items: center;
          padding: 0.1rem 0.95rem 0;
          font-size: 1.25rem;
        }
        .loa-logo-text {
          font-size: 1.45rem;
        }
      }
      @media (max-width: 380px) {
        .loa-logo-badge {
          font-size: 0.82rem;
        }
        .loa-logo-text {
          font-size: 0.9rem;
        }
      }
      /* Headings use LINE CI green (large text) */
      .loa-body .gradient-text {
        background: none;
        -webkit-text-fill-color: var(--loa-green);
        color: var(--loa-green);
      }

      /* Thai-safe heading leading — restores upper marks that tight line-height clips */
      .loa-body h1 {
        line-height: 1.35;
      }
      .loa-body h2 {
        line-height: 1.4;
      }
      .loa-body h3,
      .loa-body h4 {
        line-height: 1.45;
      }
