---
import "~/styles/index.css";
import "@fontsource-variable/noto-sans-thai";
import "@fontsource/mitr";
import "@fontsource/jetbrains-mono";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Analytics from "~/components/landing/Analytics.astro";
import codePassionLogo from "~/assets/logos/CodePassion_Icon.svg";

const TITLE =
  "Custom LINE OA Customer Portal สำหรับธุรกิจบริการ | Code Passion";
const DEMO_CTA = "นัดดู Demo สำหรับธุรกิจของคุณ";
const LINE_URL = "https://line.me/ti/p/@codepassion";
const LINE_HANDLE = "@codepassion";
const PRIVACY_POLICY_URL = import.meta.env.PUBLIC_PRIVACY_POLICY_URL ?? "";

const navLinks = [
  { href: "#use-cases", label: "ตัวอย่างใช้งาน" },
  { href: "#offer", label: "สิ่งที่ได้รับ" },
  { href: "#faq", label: "คำถามที่พบบ่อย" },
];

const heroPoints = [
  "ติดตามสถานะและดูประวัติบริการ",
  "ส่งคำขอและรับเอกสารตามสิทธิ์ของตนเอง",
  "รับแจ้งเตือนเมื่อมีความคืบหน้าหรือถึงรอบบริการ",
];

const mockJobs = [
  {
    id: "CAL-2410-018",
    title: "สอบเทียบเครื่องชั่ง 3 รายการ",
    status: "กำลังดำเนินการ",
    tone: "progress",
  },
  {
    id: "CAL-2409-102",
    title: "สอบเทียบเทอร์โมมิเตอร์",
    status: "ใบรับรองพร้อม",
    tone: "done",
    doc: true,
  },
  {
    id: "SRV-2409-077",
    title: "ซ่อมบำรุงตู้ควบคุมอุณหภูมิ",
    status: "รอรับเครื่อง",
    tone: "waiting",
  },
];

const problemQuotes = [
  "ขอเช็กสถานะให้หน่อยครับ",
  "เอกสารที่เคยส่ง อยู่ในแชตไหนนะ?",
  "ลูกค้าส่งรายละเอียดไม่ครบ ต้องถามกลับอีกแล้ว",
  "งานนี้ใครรับเรื่อง แล้วแจ้งลูกค้าไปหรือยัง?",
];

const journey = [
  "เปิด LINE OA",
  "เลือก “งานของฉัน”",
  "ดูสถานะล่าสุด",
  "เปิดเอกสารที่ได้รับสิทธิ์",
  "ติดต่อเจ้าหน้าที่เมื่อต้องให้คนช่วย",
];

const comparison = [
  [
    "ลูกค้าทักถาม เจ้าหน้าที่ค้นสถานะแล้วตอบ",
    "ลูกค้าดูสถานะจากข้อมูลที่ระบบเปิดให้เข้าถึง",
  ],
  ["ส่งรายละเอียดกระจัดกระจายในแชต", "ส่งคำขอผ่านแบบฟอร์มที่กำหนดข้อมูลจำเป็น"],
  ["ขอเอกสารเดิมซ้ำ", "เปิดเอกสารของตนเองตามสิทธิ์"],
  [
    "เจ้าหน้าที่จำวันติดตามแต่ละราย",
    "ตั้งเงื่อนไขแจ้งเตือนจากข้อมูลวันที่และสถานะ",
  ],
];

const useCases = [
  {
    icon: "mdi:scale-balance",
    title: "งานสอบเทียบและตรวจวิเคราะห์",
    body: "ส่งคำขอบริการ ติดตามสถานะ เปิดรายงานหรือใบรับรอง และรับแจ้งเตือนรอบถัดไป",
  },
  {
    icon: "mdi:wrench-outline",
    title: "งานซ่อมและบริการหลังการขาย",
    body: "แจ้งปัญหาพร้อมข้อมูลอุปกรณ์ ติดตามงานซ่อม ดูประวัติ และตรวจสอบข้อมูลการรับประกัน",
  },
  {
    icon: "mdi:calendar-sync-outline",
    title: "งานบริการแบบต่อเนื่อง",
    body: "ดูรอบนัดหมาย ส่งคำขอเพิ่มเติม และติดตามเอกสารที่เกี่ยวข้องกับบริการ",
  },
];

const integrationPaths = [
  ["หากมี API ที่เหมาะสม", "วางแผนรับส่งข้อมูลตามสิทธิ์และความสามารถของระบบ"],
  ["หากส่งออกข้อมูลได้", "พิจารณาการนำเข้าหรืออัปเดตเป็นรอบ พร้อมระบุข้อจำกัด"],
  [
    "หากระบบยังเปิดข้อมูลไม่ได้",
    "สรุปสิ่งที่ต้องประสานกับผู้ให้บริการเดิมก่อนตัดสินใจ",
  ],
];

const offerItems = [
  [
    "สรุปขั้นตอนงานและขอบเขตเป็นลายลักษณ์อักษร",
    "เห็นตรงกันว่าระบบแก้ปัญหาอะไร",
  ],
  ["แบบหน้าจอและเส้นทางใช้งานก่อนพัฒนา", "เห็นภาพและให้ความเห็นก่อนลงมือสร้าง"],
  ["Portal สำหรับหนึ่งกระบวนการ", "เริ่มจากงานที่สำคัญและตรวจรับได้"],
  [
    "การเชื่อมแหล่งข้อมูลตามขอบเขตที่ตรวจสอบแล้ว",
    "มีแนวทางเชื่อมต่อและข้อจำกัดที่ชัดเจน",
  ],
  [
    "ทดสอบสิทธิ์และสถานการณ์หลักก่อนเปิดใช้",
    "ตรวจว่าลูกค้าเข้าถึงข้อมูลที่ตนมีสิทธิ์",
  ],
  ["เปิดใช้กับกลุ่มนำร่องและส่งมอบคู่มือ", "ช่วยให้เริ่มใช้งานได้เป็นขั้นตอน"],
];

const launchKits = [
  {
    title: "Customer Onboarding Kit",
    body: "ข้อความเชิญลูกค้า วิธีเข้าถึงบริการ และคำอธิบายเมนู เพื่อให้รู้ว่าจะเริ่มใช้ตรงไหน",
  },
  {
    title: "Staff Handover Kit",
    body: "คู่มือย่อและการสอนใช้งานหนึ่งครั้ง พร้อมแนวทางรับเรื่องเมื่อมีปัญหา",
  },
  {
    title: "Usage Review",
    body: "ทบทวนผลหนึ่งครั้งหลังเปิดใช้ 30 วัน จากข้อมูลที่ระบบเก็บได้ตามขอบเขต เช่น จำนวนผู้ใช้และคำขอ พร้อมรายการปรับปรุงที่แนะนำ",
  },
];

const assurances = [
  "อนุมัติแบบหน้าจอและขั้นตอนงานก่อนเริ่มพัฒนา",
  "กำหนดรายการทดสอบและเกณฑ์ตรวจรับร่วมกัน",
  "งวดสุดท้ายชำระเมื่อผ่านการตรวจรับตามข้อตกลง",
  "เสนอรับแก้ไขข้อบกพร่องที่ทำให้ระบบไม่ตรงขอบเขตที่ตรวจรับ เป็นเวลา 60 วันหลังส่งมอบ โดยไม่คิดค่าแก้ไขเพิ่มเติม",
];

const faqs = [
  {
    q: "มี LINE OA อยู่แล้ว ใช้อันเดิมได้ไหม?",
    a: "ตรวจสอบสิทธิ์และการเชื่อมต่อที่ใช้อยู่ก่อนได้ โดยเฉพาะกรณีมี Chatbot หรือผู้ให้บริการรายอื่นดูแลอยู่ เพื่อวางแผนให้ทำงานร่วมกันได้",
  },
  {
    q: "ต้องเปลี่ยนระบบหลังบ้านหรือไม่?",
    a: "เริ่มจากประเมินการต่อยอดระบบเดิม การเชื่อมต่อจริงขึ้นอยู่กับ API การเข้าถึงข้อมูล และข้อกำหนดของผู้ให้บริการระบบนั้น",
  },
  {
    q: "ลูกค้าจะเห็นข้อมูลของคนอื่นไหม?",
    a: "ระบบต้องออกแบบการยืนยันตัวตน การผูกบัญชี และการตรวจสิทธิ์ข้อมูลตามรูปแบบธุรกิจ พร้อมทดสอบก่อนเปิดใช้ การมีบัญชี LINE เพียงอย่างเดียวไม่ได้ยืนยันสิทธิ์เข้าถึงข้อมูลองค์กรโดยอัตโนมัติ",
  },
  {
    q: "ใช้เวลาพัฒนาเท่าไร?",
    a: "ระบุแผนและหมุดหมายหลังตรวจขอบเขตและทางเชื่อมต่อ หากต้องรอข้อมูลหรือความร่วมมือจากผู้ให้บริการเดิม จะแสดงเป็นเงื่อนไขในแผนงาน",
  },
  {
    q: "มีค่าใช้จ่ายรายเดือนหรือไม่?",
    a: "อาจมีค่า Hosting ค่าดูแลระบบ แพ็กเกจหรือข้อความ LINE และบริการภายนอก โดยแยกจากค่าพัฒนาในข้อเสนอ",
  },
  {
    q: "ลูกค้าจะยอมใช้ไหม?",
    a: "เริ่มกับลูกค้ากลุ่มนำร่อง ใช้งานที่ช่วยให้เขาสะดวกขึ้นจริง และมีข้อความแนะนำวิธีใช้ จากนั้นดูข้อมูลการใช้งานและรับความเห็นก่อนขยาย",
  },
];

const channels = [
  { value: "phone", label: "เบอร์โทร" },
  { value: "email", label: "อีเมล" },
  { value: "line", label: "LINE" },
];

const topics = [
  { value: "status", label: "ตามสถานะ" },
  { value: "documents", label: "ขอเอกสาร" },
  { value: "request", label: "รับคำขอหรือแจ้งซ่อม" },
  { value: "other", label: "อื่น ๆ" },
];

const ctaClass =
  "brand-gradient hero-glow-btn inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-medium text-white transition-all duration-300 hover:scale-[1.03]";
const fieldClass =
  "mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-default outline-none transition-colors placeholder:text-offset focus:border-brand-red focus-visible:ring-2 focus-visible:ring-brand-red/40 aria-[invalid=true]:border-brand-red";
---

<!doctype html>
<html lang="th" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://codepassion.co/line-oa/" />

    <title>{TITLE}</title>
    <meta
      name="description"
      content="ให้ลูกค้าเช็กสถานะงาน ขอเอกสาร และรับแจ้งเตือนเองผ่าน LINE OA บริษัท โค้ด แพชชั่น จำกัด ออกแบบและพัฒนา Customer Portal ให้เข้ากับกระบวนการบริการและระบบเดิมของคุณ"
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:url" content="https://codepassion.co/line-oa/" />
    <meta
      property="og:title"
      content="ให้ลูกค้าเช็กงานเองผ่าน LINE — Customer Portal บน LINE OA"
    />
    <meta
      property="og:description"
      content="คืนเวลาให้เจ้าหน้าที่ดูแลงานที่ต้องใช้คน นัดดู Demo และคุยปัญหา 20 นาที ไม่มีค่าใช้จ่าย"
    />
    <meta property="og:image" content={new URL("cover.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      const themeSaved = localStorage.getItem("theme");
      if (themeSaved) {
        document.documentElement.dataset.theme = themeSaved;
      } else {
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        document.documentElement.dataset.theme = prefersDark ? "dark" : "light";
      }
    </script>

    <Analytics />
  </head>

  <body
    class="loa-body h-full overflow-x-hidden bg-background text-foreground selection:bg-brand-red selection:text-white"
  >
    <a href="#main" class="skip-to-content">ข้ามไปยังเนื้อหาหลัก</a>

    <header
      id="loa-navbar"
      class="fixed top-0 z-50 w-full border-b border-transparent transition-all duration-300"
    >
      <nav
        class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 sm:py-4"
        aria-label="เมนูหลัก"
      >
        <a
          class="flex items-center gap-2"
          href="/"
          aria-label="Code Passion - หน้าแรก"
        >
          <Image
            class="h-9 w-9 object-contain sm:h-10 sm:w-10"
            src={codePassionLogo}
            alt=""
            width={40}
            height={40}
          />
          <strong
            class="whitespace-nowrap font-bold text-default text-base sm:text-lg"
            >CodePassion</strong
          >
        </a>
        <ul class="hidden items-center gap-6 lg:flex">
          {
            navLinks.map((link) => (
              <li>
                <a
                  class="font-light text-offset transition-colors text-sm hover:text-default"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="flex items-center gap-1 sm:gap-2">
          <button
            id="loa-theme-toggle"
            type="button"
            class="hover:bg-background-offset rounded-lg p-2 text-default transition-colors"
            aria-label="สลับธีมสว่าง/มืด"
          >
            <Icon
              id="loa-icon-light"
              name="mdi:white-balance-sunny"
              class="size-5"
            />
            <Icon
              id="loa-icon-dark"
              name="mdi:weather-night"
              class="hidden size-5"
            />
          </button>
          <a
            href="#demo-form"
            data-demo-cta="nav"
            class="brand-gradient hidden rounded-lg px-4 py-2 font-medium text-white transition-all text-sm hover:scale-[1.03] md:inline-flex"
            >{DEMO_CTA}</a
          >
        </div>
      </nav>
    </header>

    <a
      href="#demo-form"
      data-demo-cta="mobile"
      class="loa-mobile-cta"
      id="loa-mobile-cta">{DEMO_CTA}</a
    >

    <main id="main">
      {/* 1 — HERO */}
      <section
        id="hero"
        class="relative overflow-hidden px-6 pb-20 pt-28 md:px-12 md:pt-36 lg:pb-28"
      >
        <div
          class="absolute -left-32 top-1/4 size-[600px] rounded-full bg-[rgba(240,77,45,0.1)] blur-[150px]"
          aria-hidden="true"
        >
        </div>
        <div class="hero-grid-bg absolute inset-0" aria-hidden="true"></div>

        <div
          class="relative z-10 mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[1.15fr_0.85fr]"
        >
          <div>
            <p class="font-light tracking-wide text-brand-red text-sm">
              Customer Portal บน LINE OA สำหรับธุรกิจบริการ
            </p>
            <h1
              class="mt-4 font-bold text-default text-4xl md:text-5xl lg:text-[3.4rem]"
            >
              ให้ลูกค้าเช็กงานเองผ่าน LINE
              <span class="gradient-text block"
                >คืนเวลาให้เจ้าหน้าที่ดูแลงานที่ต้องใช้คน</span
              >
            </h1>
            <p
              class="mt-6 max-w-2xl font-light leading-relaxed text-offset text-lg"
            >
              เปลี่ยนคำถามซ้ำ ๆ อย่าง “งานถึงไหนแล้ว?” “ขอเอกสารอีกครั้งได้ไหม?”
              ให้ลูกค้าเข้าดูข้อมูลของตัวเองได้ผ่าน LINE ที่ใช้อยู่
            </p>
            <p class="mt-4 max-w-2xl font-light leading-relaxed text-offset">
              บริษัท โค้ด แพชชั่น จำกัด ออกแบบและพัฒนา Custom LINE OA
              ให้เข้ากับกระบวนการบริการของคุณ
              พร้อมตรวจสอบแนวทางเชื่อมต่อกับระบบเดิมก่อนเริ่มโครงการ
            </p>
            <ul class="mt-6 grid gap-2.5">
              {
                heroPoints.map((point) => (
                  <li class="flex items-start gap-3 text-default">
                    <Icon
                      name="mdi:check-circle"
                      class="mt-0.5 size-5 shrink-0 text-brand-red"
                    />
                    <span class="font-light">{point}</span>
                  </li>
                ))
              }
            </ul>
            <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
              <div>
                <a href="#demo-form" data-demo-cta="hero" class={ctaClass}
                  >{DEMO_CTA}</a
                >
                <p class="mt-3 font-light text-offset text-sm">
                  คุย 20 นาที ไม่มีค่าใช้จ่าย
                  เริ่มจากขั้นตอนงานที่คุณอยากปรับปรุง
                </p>
              </div>
              <a
                href="#use-cases"
                class="self-start pt-3 text-default underline decoration-border underline-offset-4 transition-colors text-sm hover:decoration-brand-red"
                >ดูตัวอย่างการใช้งาน ↓</a
              >
            </div>
          </div>

          {/* Mock phone — demo data */}
          <figure class="mx-auto w-full max-w-[340px]">
            <div
              class="loa-phone"
              aria-label="ตัวอย่างหน้าจอ Customer Portal ใน LINE"
              role="img"
            >
              <div class="loa-phone-bar">
                <Icon name="fa-brands:line" class="size-4 text-[#06c755]" />
                <span>งานของฉัน</span>
              </div>
              <ul class="grid gap-3 p-4">
                {
                  mockJobs.map((job) => (
                    <li class="bg-background-card rounded-xl border border-border p-3.5">
                      <div class="flex items-center justify-between gap-2">
                        <span class="font-mono text-[11px] text-offset">
                          {job.id}
                        </span>
                        <span class={`loa-status loa-status-${job.tone}`}>
                          {job.status}
                        </span>
                      </div>
                      <p class="mt-1.5 text-default text-sm">{job.title}</p>
                      {job.doc ? (
                        <span class="bg-background-offset mt-3 inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-default text-xs">
                          <Icon
                            name="mdi:file-document-outline"
                            class="size-4"
                          />
