    <script>
      // Navbar scroll style
      const nav = document.getElementById("sale-navbar");
      const onScroll = () => {
        if (!nav) return;
        if (window.scrollY > 50) nav.classList.add("scrolled");
        else nav.classList.remove("scrolled");
      };
      window.addEventListener("scroll", () => requestAnimationFrame(onScroll));
      onScroll();

      // Theme toggle
      function getTheme() {
        return document.documentElement.dataset.theme || "dark";
      }
      function updateThemeIcons() {
        const isDark = getTheme() === "dark";
        document
          .querySelectorAll("#loa-icon-light")
          .forEach((el) => el.classList.toggle("hidden", !isDark));
        document
          .querySelectorAll("#loa-icon-dark")
          .forEach((el) => el.classList.toggle("hidden", isDark));
      }
      function toggleTheme() {
        const next = getTheme() === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        updateThemeIcons();
      }
      document
        .getElementById("loa-theme-toggle")
        ?.addEventListener("click", toggleTheme);
      updateThemeIcons();

      // Scroll reveals (reuse global animate-on-scroll)
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
      );
      document.querySelectorAll(".animate-on-scroll").forEach((el) => io.observe(el));

      // === Live Fit Check ===
      (function () {
        const items = Array.from(document.querySelectorAll(".loa-check"));
        const countEl = document.getElementById("loa-progress-count");
        const fillEl = document.getElementById("loa-meter-fill");
        const valueEl = document.getElementById("loa-meter-value");
        const hintEl = document.getElementById("loa-meter-hint");
        const verdictEl = document.getElementById("loa-verdict");
        const verdictTextEl = document.getElementById("loa-verdict-text");
        const total = items.length;
        const state = {};

        const verdicts = {
          low: "ระบบเดิมยังพอตอบโจทย์ — แต่น่าจะเริ่มมีจุดคับข้องใจแล้ว",
          mid: "คุณกำลังอยู่ในช่วงเปลี่ยนผ่าน เริ่มวางแผนระบบก่อนจะตามไม่ทัน",
          high: "ธุรกิจของคุณเตรียมพร้อมสำหรับระบบที่ออกแบบมาเพื่อคุณแล้ว",
        };

        function render() {
          const answered = items.filter((li) => state[li.dataset.id]);
          const yesCount = answered.filter(
            (li) => state[li.dataset.id] === "yes",
          ).length;
          const gap = total ? (yesCount / total) * 100 : 0;

          countEl.textContent = `${answered.length} / ${total}`;
          fillEl.style.width = `${gap}%`;
          valueEl.textContent = answered.length ? `${Math.round(gap)}%` : "—";

          if (!answered.length) {
            hintEl.textContent = "เลือกคำตอบเพื่อดูค่าประเมินแบบเรียลไทม์";
          } else if (answered.length < total) {
            hintEl.textContent = `ตอบแล้ว ${answered.length} จาก ${total} · เริ่มเห็นแนวโน้มแล้ว`;
          }

          if (answered.length === total) {
            const tier = yesCount <= 2 ? "low" : yesCount <= 4 ? "mid" : "high";
            hintEl.textContent = `ตรวจสอบครบทุกข้อ · พบ ${yesCount} จุดที่ระบบเดิมตามไม่ทัน`;
            verdictTextEl.textContent = verdicts[tier];
            verdictEl.classList.remove("hidden");
            verdictEl.scrollIntoView({ behavior: "smooth", block: "center" });
          } else {
            verdictEl.classList.add("hidden");
          }
        }

        items.forEach((li) => {
          const yes = li.querySelector('[data-vote="yes"]');
          const no = li.querySelector('[data-vote="no"]');
          const vote = (v) => {
            const id = li.dataset.id;
            state[id] = state[id] === v ? undefined : v;
            li.classList.toggle("is-yes", state[id] === "yes");
            yes.setAttribute(
              "aria-pressed",
              state[id] === "yes" ? "true" : "false",
            );
            no.setAttribute(
              "aria-pressed",
              state[id] === "no" ? "true" : "false",
            );
            render();
          };
          yes?.addEventListener("click", () => vote("yes"));
          no?.addEventListener("click", () => vote("no"));
        });
      })();
    </script>
  </body>
</html>
