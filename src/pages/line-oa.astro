        font-weight: 700;
      }
      .loa-status-waiting {
        background: var(--color-background-offset);
        color: var(--color-text-muted);
      }

      .loa-bubble {
        border: 1px solid var(--color-border);
        border-radius: 1.25rem 1.25rem 1.25rem 0.3rem;
        background: var(--color-background-card);
        padding: 1.1rem 1.25rem;
        color: var(--color-text);
      }

      .loa-card-accent {
        border-color: rgba(6, 199, 85, 0.3) !important;
        box-shadow: 0 0 40px rgba(6, 199, 85, 0.06);
      }

      .loa-faq summary::-webkit-details-marker {
        display: none;
      }

      .loa-mobile-cta {
        position: fixed;
        left: 1rem;
        right: 1rem;
        bottom: 1rem;
        z-index: 40;
        display: flex;
        justify-content: center;
        padding: 0.9rem 1rem;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        background: var(--loa-green);
        color: #fff;
        font-weight: 700;
        font-size: 0.95rem;
        box-shadow: 0 10px 40px rgba(6, 199, 85, 0.4);
        transition:
          opacity 0.2s,
