        background: var(--loa-green-hover);
        box-shadow: 0 12px 32px rgba(6, 199, 85, 0.36);
      }
      .loa-btn-line:focus-visible {
        outline: 3px solid var(--loa-accent);
        outline-offset: 3px;
      }
      .loa-line-card {
        border: 1px solid var(--color-border);
        border-radius: 1.5rem;
        background: var(--color-background-card);
        box-shadow: 0 24px 60px rgba(6, 199, 85, 0.1);
      }
      .loa-step {
        display: inline-flex;
        flex-shrink: 0;
        width: 1.6rem;
        height: 1.6rem;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: var(--loa-green);
        color: #fff;
        font-size: 0.8rem;
        font-weight: 700;
      }

      .loa-logo {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: "Prompt", var(--font-sans, sans-serif);
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
