---

<!doctype html>
<html lang="th" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://codepassion.co/line-oa" />

    <title>โตเกินกว่าระบบสำเร็จรูป — Custom LINE OA Solutions | Code Passion</title>
    <meta
      name="description"
      content="ธุรกิจคุณไม่สำเร็จรูป LINE OA ก็ไม่ควรสำเร็จรูป Code Passion ออกแบบและพัฒนา Custom LINE OA Solution ให้ทำงานตาม Workflow จริงของธุรกิจคุณ รับ LINE OA Fit Check วันนี้"
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:url" content="https://codepassion.co/line-oa" />
    <meta
      property="og:title"
      content="โตเกินกว่าระบบสำเร็จรูป — Custom LINE OA Solutions"
    />
    <meta
      property="og:description"
      content="ธุรกิจคุณไม่สำเร็จรูป LINE OA ก็ไม่ควรสำเร็จรูป สร้างระบบให้เข้ากับวิธีขายของคุณ รับ LINE OA Fit Check ฟรี"
    />
    <meta property="og:image" content={new URL("cover.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Initialize theme (respect saved preference / system) -->
    <script is:inline>
      const themeSaved = localStorage.getItem("theme");
      if (themeSaved) {
        document.documentElement.dataset.theme = themeSaved;
      } else {
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        document.documentElement.dataset.theme = prefersDark ? "dark" : "light";
      }
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (event) => {
          if (!localStorage.getItem("theme")) {
            document.documentElement.dataset.theme = event.matches
              ? "dark"
              : "light";
          }
        });
    </script>
  </head>

  <body
    class="loa-body h-full overflow-x-hidden bg-background text-foreground selection:bg-brand-red selection:text-white"
  >
    <a href="#hero" class="skip-to-content">Skip to main content</a>

    {/* ===== Header (matches main Navbar style) ===== */}
    <header
      id="sale-navbar"
      class="fixed top-0 z-50 w-full border-b border-transparent transition-all duration-300"
    >
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 sm:py-4"
      >
        <a class="flex items-center gap-2" href="/" aria-label="Code Passion - Home">
          <Image
            class="h-9 w-9 object-contain sm:h-10 sm:w-10"
            src={codePassionLogo}
            alt="Code Passion Logo"
            width={40}
            height={40}
          />
          <strong
            class="whitespace-nowrap text-base font-bold text-default sm:text-lg"
            >CodePassion</strong
          >
        </a>
        <div class="flex items-center gap-1 sm:gap-2">
          <button
            id="loa-theme-toggle"
            type="button"
            class="rounded-lg p-2 text-default transition-colors hover:bg-background-offset"
            aria-label="Toggle theme"
          >
            <Icon id="loa-icon-light" name="mdi:white-balance-sunny" class="size-5" />
            <Icon id="loa-icon-dark" name="mdi:weather-night" class="hidden size-5" />
          </button>
          <a
            href={LINE_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="เพิ่มเพื่อน LINE OA @codepassion"
            class="loa-btn-line inline-flex items-center gap-2 rounded-lg px-2.5 py-2 text-sm font-medium transition-all sm:px-5 sm:py-2.5"
          >
            <Icon name="fa-brands:line" class="size-5 sm:size-4" />
            <span class="hidden sm:inline">เพิ่มเพื่อน LINE OA</span>
          </a>
        </div>
      </div>
    </header>

    {/* ===== Sticky LINE rail (desktop) ===== */}
    <aside class="loa-rail" aria-label="Add Code Passion on LINE">
      <a class="loa-rail-btn" href={LINE_URL} target="_blank" rel="noopener noreferrer">
        <span class="loa-rail-vlabel">เพิ่มเพื่อน&nbsp;LINE&nbsp;OA</span>
        <span class="loa-rail-line" aria-hidden="true"></span>
        <Icon name="mdi:chevron-right" class="size-4" />
      </a>
    </aside>

    {/* ===== Mobile sticky CTA ===== */}
    <a
      class="loa-mobile-cta"
      href={LINE_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="fa-brands:line" class="size-5" />
      รับ Fit Check ใน LINE →
    </a>

    <main id="hero">
      {/* ============================================================ */}
      {/* HERO                                                          */}
      {/* ============================================================ */}
      <section
        class="relative flex min-h-screen items-center overflow-hidden px-6 pt-28 pb-20 md:px-12"
      >
        <div
          class="absolute -left-32 top-1/4 size-[600px] rounded-full bg-[rgba(240,77,45,0.12)] blur-[150px]"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute -right-32 bottom-1/4 size-[500px] rounded-full bg-[rgba(237,27,93,0.08)] blur-[130px]"
          aria-hidden="true"
        >
        </div>
        <div class="hero-grid-bg absolute inset-0" aria-hidden="true"></div>
        <div
          class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent"
          aria-hidden="true"
        >
        </div>

        <div class="relative z-10 mx-auto w-full max-w-4xl text-center">
          <div
            class="loa-glass animate-on-scroll mb-6 inline-flex items-center gap-2 rounded-full px-4 py-2"
          >
            <span class="relative flex size-2">
              <span
                class="absolute inline-flex size-full animate-ping rounded-full bg-brand-red opacity-75"
              ></span>
              <span class="brand-gradient relative inline-flex size-2 rounded-full"></span>
            </span>
            <span class="text-xs font-light text-offset"
              >Campaign · โตเกินกว่าระบบสำเร็จรูป</span
            >
          </div>

          <h1
            class="animate-on-scroll text-4xl font-bold text-default md:text-5xl lg:text-6xl"
          >
            ธุรกิจคุณ
            <span class="loa-strike">ไม่สำเร็จรูป</span><br />
            <span class="gradient-text">LINE OA ก็ไม่ควรสำเร็จรูป</span>
          </h1>

          <p
            class="animate-on-scroll mx-auto mt-8 max-w-2xl text-lg font-light leading-relaxed text-offset"
          >
            เมื่อธุรกิจโตขึ้น ลูกค้าเพิ่มขึ้น ทีมงานเพิ่มขึ้น
            ขั้นตอนการขายและบริการซับซ้อนขึ้น —
            ระบบเดิมอาจเริ่มตามธุรกิจไม่ทัน
          </p>

          <div class="animate-on-scroll mt-12 flex flex-wrap justify-center gap-4">
            <a
              href="#fit-check"
              class="brand-gradient hero-glow-btn group inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-medium text-white transition-all duration-300 hover:scale-105"
            >
              เริ่ม LINE OA Fit Check
              <Icon
                name="mdi:arrow-down"
                class="size-4 transition-transform duration-300 group-hover:translate-y-1"
              />
            </a>
            <a
              href={LINE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="loa-btn-line inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-medium text-white transition-all duration-300 hover:scale-105"
            >
              <Icon name="fa-brands:line" class="size-4" />
              เพิ่มเพื่อน LINE OA
            </a>
          </div>

          <div class="animate-on-scroll mt-14 flex flex-wrap justify-center gap-3">
            {
              [
                "Custom LINE OA Solutions",
                "ทำงานตาม Workflow จริง",
                "เริ่มต้นจากจุดที่เจ็บที่สุด",
              ].map((t) => (
                <div class="loa-glass flex items-center gap-2.5 rounded-full px-4 py-2">
                  <span class="brand-gradient size-1.5 rounded-full" />
                  <span class="text-xs font-light text-offset">{t}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {/* ============================================================ */}
      {/* 02 — THE OUTGROWING ARC                                       */}
      {/* ============================================================ */}
      <section class="animate-on-scroll px-6 py-24 md:px-12 lg:py-32">
        <div class="mx-auto max-w-7xl">
          <p class="text-sm font-light uppercase tracking-widest text-offset">
            วันที่มันเคยเพียงพอ
          </p>
          <h2 class="gradient-text mt-2 text-3xl font-bold md:text-4xl lg:text-5xl">
            จากที่เคยพอ — สู่ที่ตามไม่ทัน
          </h2>

          <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-[1fr_auto_1fr] md:items-stretch">
            <div class="glass-card animate-on-scroll p-8">
              <span
                class="inline-block rounded-full border border-border bg-background-offset px-3 py-1 text-xs font-light text-offset"
                >THEN</span
              >
              <p class="mt-4 text-lg font-light leading-relaxed text-default">
                คุณอาจเริ่มต้น LINE OA ด้วย Rich Menu ข้อความตอบกลับอัตโนมัติ
                ระบบจอง หรือแพ็กเกจสำเร็จรูป
              </p>
              <p class="mt-3 font-light italic text-offset">และมันอาจเคยเพียงพอในวันนั้น</p>
            </div>

            <div class="hidden items-center justify-center md:flex">
              <Icon name="mdi:arrow-right" class="size-7 text-brand-red" />
            </div>
            <div class="flex items-center justify-center md:hidden">
              <Icon name="mdi:arrow-down" class="size-7 text-brand-red" />
            </div>

            <div
              class="loa-card-accent glass-card animate-on-scroll p-8 transition-all duration-300 hover:-translate-y-1"
            >
              <span
                class="brand-gradient inline-block rounded-full px-3 py-1 text-xs font-medium text-white"
                >NOW</span
              >
              <p class="mt-4 text-lg font-light leading-relaxed text-default">
                แต่เมื่อธุรกิจโตขึ้น ลูกค้าเพิ่มขึ้น ทีมงานเพิ่มขึ้น
                ขั้นตอนการขายและบริการซับซ้อนขึ้น
              </p>
              <p class="mt-3 text-lg font-medium text-default">
                ระบบเดิมอาจเริ่ม<span class="text-brand-red">ตามธุรกิจไม่ทัน</span>
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* ============================================================ */}
      {/* 03 — LIVE FIT CHECK                                          */}
      {/* ============================================================ */}
      <section class="animate-on-scroll px-6 py-24 md:px-12 lg:py-32" id="fit-check">
        <div class="mx-auto max-w-4xl">
          <p class="text-sm font-light uppercase tracking-widest text-offset">
            LINE OA Fit Check · Live
          </p>
          <h2 class="gradient-text mt-2 text-3xl font-bold md:text-4xl lg:text-5xl">
            คุณกำลังเจอสิ่งเหล่านี้หรือไม่?
          </h2>
          <p class="mt-4 max-w-2xl text-lg font-light text-offset">
            ตอบคำถามเพื่อวัดระยะห่างระหว่างระบบปัจจุบันกับสิ่งที่ธุรกิจต้องการ
          </p>

          <div class="glass-card animate-on-scroll mt-10 overflow-hidden p-6 md:p-8">
            <div class="mb-5 flex items-center justify-between">
              <span class="flex items-center gap-2 text-sm font-light text-offset">
                <span class="relative flex size-2">
                  <span
                    class="absolute inline-flex size-full animate-ping rounded-full bg-brand-red opacity-75"
                  ></span>
                  <span class="brand-gradient relative inline-flex size-2 rounded-full"></span>
                </span>
                กำลังวิเคราะห์
              </span>
              <span class="font-mono text-sm text-brand-red" id="loa-progress-count"
                >0 / 6</span
              >
            </div>

            <ol class="grid gap-3" id="loa-checklist">
              {
                symptoms.map((s, i) => (
                  <li
                    class="loa-check flex flex-col gap-3 rounded-xl border border-border bg-background-offset p-4 transition-all sm:flex-row sm:items-center sm:justify-between"
                    data-id={s.id}
                  >
                    <div class="flex items-start gap-3">
                      <span class="mt-0.5 font-mono text-sm text-offset">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <span class="text-default">{s.q}</span>
                    </div>
                    <div class="flex shrink-0 gap-2" role="group" aria-label={s.q}>
                      <button
                        class="loa-btn loa-btn-yes rounded-lg border border-border px-4 py-1.5 text-sm transition-all"
                        type="button"
                        data-vote="yes"
                        aria-pressed="false"
                      >
                        ใช่
                      </button>
                      <button
                        class="loa-btn loa-btn-no rounded-lg border border-border px-4 py-1.5 text-sm text-offset transition-all"
                        type="button"
                        data-vote="no"
                        aria-pressed="false"
                      >
                        ไม่ใช่
                      </button>
                    </div>
                  </li>
                ))
              }
            </ol>

            {/* Score meter */}
            <div class="mt-6">
              <div class="flex items-baseline justify-between">
                <span class="text-xs font-light uppercase tracking-widest text-offset"
                  >Readiness Gap</span
                >
                <span class="font-mono text-sm text-brand-red" id="loa-meter-value">—</span>
              </div>
              <div
                class="mt-2 h-2 overflow-hidden rounded-full border border-border bg-background"
                aria-hidden="true"
              >
                <div class="loa-meter-fill h-full w-0 rounded-full" id="loa-meter-fill"></div>
              </div>
              <p class="mt-3 text-sm font-light text-offset" id="loa-meter-hint">
                เลือกคำตอบเพื่อดูค่าประเมินแบบเรียลไทม์
              </p>
            </div>

            {/* Verdict */}
            <div class="loa-verdict hidden" id="loa-verdict">
              <div class="my-6 border-t border-dashed border-border"></div>
              <p class="text-xs font-light uppercase tracking-widest text-brand-red">
                Diagnosis Complete
              </p>
              <p class="mt-3 text-xl font-medium text-default" id="loa-verdict-text"></p>
              <p class="mt-2 font-light leading-relaxed text-offset">
                ปัญหาอาจไม่ใช่ว่าคุณใช้ LINE OA ไม่ดีพอ แต่ธุรกิจของคุณอาจ
                <span class="gradient-text font-medium">โตเกินกว่าระบบสำเร็จรูป</span>
                แล้ว
              </p>
              <a
                class="brand-gradient hero-glow-btn mt-6 inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-medium text-white transition-all duration-300 hover:scale-105"
                href={LINE_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                รับ Fit Check เต็มใน LINE
                <Icon name="mdi:arrow-right" class="size-4" />
              </a>
              <p class="mt-3 text-xs font-light text-offset">
                แอด LINE {LINE_HANDLE} · ทักแชทรับการวิเคราะห์แบบเต็ม
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* ============================================================ */}
      {/* 04 — VERDICT                                                 */}
      {/* ============================================================ */}
      <section class="animate-on-scroll px-6 py-20 md:px-12">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-2xl font-medium leading-relaxed text-default md:text-3xl">
            หากคำตอบคือ <span class="gradient-text">“ใช่”</span>
            ปัญหาอาจไม่ใช่ว่าคุณใช้ LINE OA ไม่ดีพอ
            แต่ธุรกิจของคุณอาจ<span class="loa-strike-dim">โตเกินกว่าระบบสำเร็จรูป</span>แล้ว
          </p>
        </div>
      </section>

      {/* ============================================================ */}
      {/* 05 — THE SHIFT                                               */}
      {/* ============================================================ */}
      <section class="animate-on-scroll px-6 py-24 md:px-12 lg:py-32">
