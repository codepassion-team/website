        --color-brand-orange-red: var(--loa-accent);
        --color-brand-pink-red: #00a843;
        --color-background: #ffffff;
        --color-background-card: #ffffff;
        --color-background-offset: #f4f7f5;
        --color-border: #e3e8e5;
