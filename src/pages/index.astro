---
import "~/styles/index.css";
import "@fontsource-variable/noto-sans-thai";
import "@fontsource/mitr";
import "@fontsource/jetbrains-mono";

import Navbar from "~/components/layout/Navbar.astro";
import Hero from "~/components/home/Hero.astro";
import Certifications from "~/components/home/Certifications.astro";
import Services from "~/components/home/Services.astro";
import Process from "~/components/home/Process.astro";
import TechStack from "~/components/home/TechStack.astro";
import Clients from "~/components/home/Clients.astro";
import Team from "~/components/home/Team.astro";
import Testimonials from "~/components/home/Testimonials.astro";
import Products from "~/components/home/Products.astro";
import CTA from "~/components/home/CTA.astro";
import Footer from "~/components/layout/Footer.astro";

const { generator, site } = Astro;
const image = new URL("cover.jpg", site);
const description =
  "Code Passion builds innovative and feasible solutions for companies and communities. Custom web applications, enterprise systems, and digital platforms built with passion.";
---

<!doctype html>
<html lang="en" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <meta name="generator" content={generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://codepassion.co/" />

    <!-- Primary Meta -->
    <title>
      Code Passion Co., Ltd. | Software Development & Workengine Platform
      Thailand
    </title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="software development Thailand, web development company Bangkok, custom system development, Workengine, LINE integration Thailand, Supabase development, Next.js developer Thailand, ElysiaJS, Bun API"
    />

    <!-- Open Graph -->
    <meta
      property="og:title"
      content="Code Passion Co., Ltd. | Software Development"
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:description"
      content="We build custom systems, web apps, and digital platforms that drive real business growth."
    />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={site} />
    <meta property="og:locale" content="en_US" />
    <meta property="fb:app_id" content="1048058969988849" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Code Passion | Software Development Thailand"
    />
    <meta
      name="twitter:description"
      content="Custom systems, web apps & digital platforms built with passion."
    />
    <meta name="twitter:image" content={image} />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Code Passion Co., Ltd.",
        "url": "https://codepassion.co",
        "description": "Software development company. Creators of Workengine.",
        "areaServed": "TH",
        "foundingDate": "2020",
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+66886384566",
          "contactType": "customer service",
          "availableLanguage": ["Thai", "English"]
        },
        "sameAs": [
          "https://facebook.com/codepassion.co",
          "https://github.com/codepassion-team",
          "https://www.youtube.com/@code-passion"
        ]
      }
    </script>

    <!-- Initialize theme -->
    <script is:inline>
      const themeSaved = localStorage.getItem("theme");
      if (themeSaved) {
        document.documentElement.dataset.theme = themeSaved;
      } else {
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        document.documentElement.dataset.theme = prefersDark ? "dark" : "light";
      }
      window
        .matchMedia("(prefers-color-scheme: light)")
        .addEventListener("change", (event) => {
          if (!localStorage.getItem("theme")) {
            document.documentElement.dataset.theme = event.matches
              ? "dark"
              : "light";
          }
        });
    </script>
  </head>
  <body
    class="h-full overflow-x-hidden bg-background text-foreground selection:bg-brand-red selection:text-white"
  >
    <a href="#about" class="skip-to-content">Skip to main content</a>

    <Navbar />

    <main id="main-content">
      <Hero />
      <Certifications />
      <Clients />
      <Services />
      <Process />
      <TechStack />
      <Team />
      <Testimonials />
      <Products />
      <CTA />
    </main>

    <Footer />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
      );
      document.querySelectorAll(".animate-on-scroll").forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
